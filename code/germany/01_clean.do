cap log close
log using "$log/01_clean.log", replace        

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
	
	SIAB Preparation
	
	Do-File for Preparation of SIAB Data

	This do-file prepares the dataset, renames variables,
	removes doubled observations, and creates relevant labour market variables.
	
	Jenny Peters

~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/

use "$orig/siab_7521_v1.dta", clear
label language en 
label val _all

rename persnr_siab id
rename betnr_siab firmID
rename spell jobcount
rename quelle source
rename begepi dtin
rename endepi dtout
rename frau sex_d
rename nation_gr nat
rename gebjahr dtbirth
rename ausbildung vocational_training
rename schule education
rename tentgelt wage
rename teilzeit part_time
rename erwstat employment_status
rename gleitz midi_jobs
rename leih temp_ag
rename befrist fixed_term
rename grund cause
rename alo_dau days_unemp



recast long id

* * * * * * * * * * * * * * * Personal Variables * * * * * * * * * * * * * * * *

//generate year variable
qui gen int yr_begepi=year(dtin)
qui gen int month_begepi=month(dtin)
qui gen int day_begepi=day(dtout)
qui gen int yr_endepi=year(dtout)
qui gen int month_endepi=month(dtout)
qui gen int day_endepi=day(dtout)

// Age 
qui gen age=yr_begepi-dtbirth+1
//drop if age<25|age>=55

// Dummy for younger than 30 when spell started
qui gen age_d_y=1 if age<30 & age!=.
// Dummy for age more or equal to 40 when spell started
qui gen age_d_o=1 if age>=40 & age!=.

// German Dummy
qui g german = 0
qui replace german = 1 if nat==0
drop if german==.

qui g foreign_born = 1
qui replace foreign_born = 0 if german==1


// East (east=1) or West Germany (east=0),
gen byte east = inrange(wo_bula, 11, 16) if !missing(wo_bula)
drop wo_*                  

//Education (categories changed in 2011 to match ISCED 2011)

qui gen byte educ2=0 if education==.z 
qui replace educ2=0 if education==.n

*primary school
qui replace educ2=1 if education==1 


*secondary school - sekundarbereich I
qui replace educ2=2 if education==4
qui replace educ2=2 if education==5
qui replace educ2=2 if education==6

replace educ2=2 if educ2==0 & ausbildung_imp ==1

*higher - sekundarbereich II
qui replace educ2=3 if education==8
qui replace educ2=3 if education==9
qui replace educ2=3 if education==7

qui replace educ2=3 if educ2==0 & ausbildung_imp ==2
qui replace educ2=3 if educ2==0 & ausbildung_imp ==3
qui replace educ2=3 if educ2==0 & ausbildung_imp ==4


*college/university
qui replace educ2=4 if inlist(ausbildung_imp, 5, 6)

qui gen college=1 if educ2==4

//problem here: educ2 is wrong when firmID is missing, so replace with previous educ
by id: egen max_educ = max(educ2)
by id: replace educ2 = max_educ if educ2 != max_educ


* * * * * * * * * * * * * * Labour Market Variables * * * * * * * * * * * * * * 

// sort entirely parallel observations generated by spell splitting

bysort id dtin source (jobcount): gen byte level1 = _n-1 //observation counter per episode and source
bysort id dtin (jobcount): gen byte level2 = _n-1 //observation counter per episode

// delete double entries (lower wage) before aggregation by year
sort id dtin source
qui gen byte index = 0
by id: replace index=1 if dtin==dtin[_n-1] & dtout==dtout[_n-1] & firmID==firmID[_n-1] & source==1
qui replace index = index[_n+1]
qui drop if index==1
drop index



//Employment all
g byte work=0
replace work = 1 if employment_status==101 & source==1 //Sozialversicherungspflichtig Beschäftigte
replace work = 1 if employment_status==140 & source==1 //Sozialversicherungspflichtig Beschäftigte
replace work = 1 if employment_status==143 & source==1 //Sozialversicherungspflichtig Beschäftigte
replace work = 1 if employment_status==103 & source==1 //Beschäftigte in Altersteilzeit
replace work = 1 if employment_status==142 & source==1 //Beschäftigte in Altersteilzeit
replace work = 1 if employment_status==109 & source==1 //Geringfügig Beschäftigte (mini)
replace work = 1 if employment_status==209 & source==1 //Geringfügig Beschäftigte (mini)
replace work = 1 if employment_status==102 & source==1 //Auszubildende
replace work = 1 if employment_status==141 & source==1 //Auszubildende
replace work = 1 if employment_status==121 & source==1 //Auszubildende
replace work = 1 if employment_status==122 & source==1 //Auszubildende

** Creating labour market state variable **
qui g state=0

//Unemployed
replace state = 1 if employment_status==11 //Arbeitslosengeld
replace state = 1 if employment_status==12 //Arbeitslosenhilfe
replace state = 1 if employment_status==13 //Unterhaltsgeld (Arbeitslosengeld bei Weiterbildung)
replace state = 1 if employment_status==14 //Unterhaltsgeld (Arbeitslosengeld bei Weiterbildung)
replace state = 1 if employment_status==15 //Beiträge zur privaten Pflegeversicherung
replace state = 1 if employment_status==31 //Arbeitslos (ALO)
replace state = 1 if employment_status==41 //Arbeitslos (ALO)
replace state = 1 if employment_status==51 //Arbeitslos (ALO)
replace state = 1 if employment_status==2 //Minderjährige erwerbsfähige Person
replace state = 1 if employment_status==8 //Minderjährige erwerbsfähige Person
replace state = 1 if employment_status==1 //Volljährige erwerbsfähige Person
replace state = 1 if employment_status==6 //Volljährige erwerbsfähxige Person
replace state = 1 if employment_status==7 //Volljährige erwerbsfähige Person
replace state = 1 if employment_status==10001 //Aktivierung und berufliche Eingliederung
replace state = 1 if employment_status==10 //minor and able to work
replace state = 1 if employment_status==5 //Long-term private care insurance
replace state = 1 if employment_status==112 //minor and able to work
replace state = 1 if employment_status==3 //UHG



// Regular Employment
replace state = 2 if fixed_term==0 & employment_status==101 
replace state = 2 if fixed_term==0  & employment_status==140 
replace state = 2 if fixed_term==0  & employment_status==143 
replace state = 2 if fixed_term==0  & employment_status==103
replace state = 2 if fixed_term==0  & employment_status==142 


// Marginal Employment and temporary employment
replace state = 3 if employment_status==109 //Geringfügig Beschäftigte (mini)
replace state = 3 if employment_status==209 //Geringfügig Beschäftigte (mini)
// other temporary employment (fixed term contracts)
replace state = 3 if fixed_term==1 & employment_status==101 
replace state = 3 if fixed_term==1 & employment_status==140 
replace state = 3 if fixed_term==1 & employment_status==143 
replace state = 3 if fixed_term==1 & employment_status==103
replace state = 3 if fixed_term==1 & employment_status==142 


// Non-identified/Non-Employed
replace state = 4 if employment_status == .z 
replace state = 4 if employment_status==32 //arbeitsunfähig
replace state = 4 if employment_status==104 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==112 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==118 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status==119 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==120 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==123 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==124 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==149 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==201 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==203 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==205 //Sonstiger Beschäftigungsstatus
replace state = 4 if employment_status ==599 //Sonstiger Beschäftigungsstatus

* --- pre-2011 permanent days per person, overlap-corrected, BEFORE the drop ---
preserve
    keep if inlist(employment_status,101,140,143,103,142) & yr_begepi<2011 & state==0

    * merge overlapping/adjacent spells within a person (interval union)
    sort id dtin dtout
    by id (dtin dtout): gen double cummax = dtout if _n==1
    by id (dtin dtout): replace cummax = max(dtout, cummax[_n-1]) if _n>1
    by id (dtin dtout): gen byte newblk = (_n==1) | (dtin > cummax[_n-1] + 1)   // gap -> new block
    by id (dtin dtout): gen int  block  = sum(newblk)

    * one merged interval per (id, block); sum their lengths per person
    collapse (min) bs=dtin (max) be=dtout, by(id block)
    gen double blkdays = be - bs + 1
    collapse (sum) days_p_pre2011 = blkdays, by(id)

    tempfile ppd
    save `ppd'
restore

merge m:1 id using `ppd', keep(master match) nogen
replace days_p_pre2011 = 0 if missing(days_p_pre2011)

drop if state==0

//modified state: temporary and unemployed vs permanent employment
qui gen str state_c="NA"
replace state_c= "TU"  if state ==1 //unemployed
replace state_c= "TU"  if state ==3 //temporary/marginal employment
replace state_c= "TU"  if state ==4 //Non-employed
replace state_c= "P"  if state ==2 //permanent employment



// state detail variable to keep track of mini, midi, temp - not mutually exclusive
// some temp agency work is mini jobs

qui gen str state_detail="NA"
replace state_detail = "non-employment" if state ==4
replace state_detail = "permanent" if state ==2
replace state_detail = "unemployed" if state ==1
replace state_detail= "mini permanent" if employment_status == 109 & fixed_term == 0
replace state_detail= "mini permanent" if employment_status == 209 & fixed_term == 0
replace state_detail= "mini temporary" if employment_status == 109 & fixed_term == 1
replace state_detail= "mini temporary" if employment_status == 209 & fixed_term == 1
replace state_detail= "mini total" if employment_status == 109
replace state_detail= "mini total" if employment_status == 209
replace state_detail= "midi permanent" if midi_job == 1 & fixed_term == 0
replace state_detail= "midi temporary" if midi_job == 1 & fixed_term == 1
replace state_detail= "midi total" if midi_job == 1
replace state_detail = "temp agency permanent" if temp_ag == 1 & fixed_term == 0 
replace state_detail = "temp agency temporary" if temp_ag == 1 & fixed_term == 1
replace state_detail = "temp agency total" if temp_ag == 1 

g sampl=(source!=1)

//Trainees
g trainees=0
replace trainees=1 if inlist(employment_status, 102, 141, 121, 122)

//Marginal Employment 
g Marg_Employment=0
replace Marg_Employment=1 if state==3


// Unemployment
g UE=0
replace UE=1 if state==1

qui egen long id2=group(id)
order id2, after (id)
drop id
rename id2 id
drop jobcount
bysort id: gen int jobcount=_n

qui egen long id2=group(id)
drop id
rename id2 id

* * * * * * * * * * * * * * * * * Industries * * * * * * * * * * * * * * * * * *

//merge with bhp for establishment/industry data 
rename yr_begepi jahr //renaming for merge
rename firmID betnr_siab

sort betnr_siab jahr
//merge only industries created by extrapolation/imputation
merge m:1 betnr_siab jahr using $orig/SIAB_7521_v1_bhp_basis_v1.dta, keepusing(w08_3_gen)

rename betnr_siab firmID 
rename jahr yr_begepi

qui g ind_short = 0 

//Agriculture, forestry and fishing; mining and quarrying and other industry
replace ind_short = 1 if inrange(w08_3_gen, 11, 32)
replace ind_short = 1 if inrange(w08_3_gen, 51, 99)
replace ind_short = 1 if inrange(w08_3_gen, 351, 353)
replace ind_short = 1 if inrange(w08_3_gen, 360, 390)

//Manufacturing 1
replace ind_short = 2 if inrange(w08_3_gen, 101, 120)
replace ind_short = 2 if inrange(w08_3_gen, 131, 152)
replace ind_short = 2 if inrange(w08_3_gen, 161, 182)
replace ind_short = 2 if inrange(w08_3_gen, 310, 332)

//Manufacturing 2
replace ind_short = 3 if w08_3_gen == 191
replace ind_short = 3 if w08_3_gen == 192
replace ind_short = 3 if inrange(w08_3_gen, 201, 206)
replace ind_short = 3 if w08_3_gen == 211
replace ind_short = 3 if w08_3_gen == 212
replace ind_short = 3 if inrange(w08_3_gen, 221, 239)
replace ind_short = 3 if inrange(w08_3_gen, 241, 259)

//Manufacturing 3
replace ind_short = 4 if inrange(w08_3_gen, 261, 268)
replace ind_short = 4 if inrange(w08_3_gen, 271, 279)
replace ind_short = 4 if inrange(w08_3_gen, 281, 289)
replace ind_short = 4 if inrange(w08_3_gen, 291, 309)


//Construction
replace ind_short = 5 if inrange(w08_3_gen, 411, 439)

//Wholesale and Retail Trades
replace ind_short = 6 if inrange(w08_3_gen, 451, 479)

//Transportation and Storage
replace ind_short = 7 if inrange(w08_3_gen, 491, 532)

//Accommodation and food service activities
replace ind_short = 8 if inrange(w08_3_gen, 551, 563)

//Information and communication; Real estate activities: Business services
replace ind_short = 9 if inrange(w08_3_gen, 581, 639)
replace ind_short = 9 if inrange(w08_3_gen, 681, 829)

//Financial and Insurance Activities
replace ind_short = 10 if inrange(w08_3_gen, 641, 663)

//Public Admin and Defence
replace ind_short = 11 if inrange(w08_3_gen, 841, 843)

//Education
replace ind_short = 12 if inrange(w08_3_gen, 851, 856)

//Health Services, residential Care, Social Work
replace ind_short = 13 if inrange(w08_3_gen, 861, 889)

//Other Services
replace ind_short = 13 if inrange(w08_3_gen, 900, 990)

  
* * * * * * * * * * * * * * * * * * Labels * * * * * * * * * * * * * * * * * * *
label variable id "Individual ID"
label variable dtin "Episode start date"
label variable dtout "Episode end date"
label variable cause "Reason of cancellation/notification/termination"
label variable yr_begepi "Start year of observation"
label variable month_begepi "Start month of observation"
label variable day_begepi "Start day of observation"
label variable yr_endepi "End year of observation"
label variable month_endepi "End month of observation"
label variable day_endepi "End month of observation"
label variable german "Nationality"
label variable education "Education"
label variable sex_d "Female Dummy"
label variable source "Source of Spell"
label variable employment_status "Employment Status"
label variable dtbirth "Year of birth"
label variable jobcount "Observation Counter"
label variable firmID "Establishment Counter"
label variable part_time "Part-Time Employment"
label variable midi_jobs "Transition zone (Midi-jobs)"
label variable temp_ag "Temporary Agency Work"
label variable fixed_term "Fixed Term Contract"
label variable days_u "Duration of Unemployment"
label variable wage "Daily wage/daily benefit, rounded"
label variable age "Age"
label variable college "College or higher education"
label variable east "East Germany"                          					 	
label define east 0 "no" 1 "yes", replace                    					
label values east east
label variable state "Employment Status"                          					 	
label define state 1 "Unemployed" 2 "Employees subject to social insurance contributions" 3 "Marginal/Temporary Employment" 4 "Non-Identified" , replace
label variable Marg_Employment "Marginal Employment"
label variable UE "Unemployed"
label variable trainees "Trainees"
label define lblEduc 1 "Primary School" 2 "Lower Secondary School" 3 "Upper Secondary School" 4 "University"
label values educ2 lblEduc
label variable state_detail "Detailed Employment State"
label variable state_c "Modified Spell Type"
label variable ind_short "Industry"
label define industry_codes 0 "NA" 1 "Agriculture" 2 "Manufacturing 1" 4 "Manufacturing 2" ///
 4 "Manufacturing 3" 5 "Construction" 6 "Wholesale and Retail Trades" ///
 7 "Transportation and Storage" 8 "Hospitality" 9  "Business Services"  ///
10 "Financial and Insurance" 11 "Public Admin and Defence" 12 "Education" ///
13 "Health Services" 14 "Other services"
label values ind_short industry_codes


compress
save "$data/01_dataprep.dta", replace          					



log close
clear
